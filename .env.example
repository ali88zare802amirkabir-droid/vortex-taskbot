# Copy this file to `.env` and fill in real values.
# `.env` is gitignored (secrets) — only this template is committed.

PORT=3000

# ── Render: PostgreSQL (دیتابیس کامل) ──
# بعد از ساخت دیتابیس Postgres رایگان در Render، مقدارش رو اینجا بذار یا
# مستقیم توی دسته‌بندی Environment توی Render ست کن.
# DATABASE_URL=postgres://user:pass@host:port/vortex_taskbot

# ── حالت لوکال (بدون Postgres) ──
# اگر DATABASE_URL ست نباشه، خودکار روی فایل محلی data/db.json ذخیره میشه.
# DB_FILE=data/db.json