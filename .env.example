# Copy this file to `.env` and fill in real values.
# `.env` is gitignored (secrets) — only this template is committed.

PORT=3000

# ── Render: PostgreSQL (دیتابیس کامل) ──
# بعد از ساخت دیتابیس Postgres رایگان در Render، مقدارش رو اینجا بذار یا
# مستقیم توی دسته‌بندی Environment توی Render ست کن.
# DATABASE_URL=postgres://user:pass@host:port/vortex_taskbot

# ── حالت لوکال (بدون Postgres) ──
# اگر DATABASE_URL ست نباشه، خودکار روی فایل محلی data/db.json ذخیره میشه.
# DB_FILE=data/db.json

# ── هوش مصنوعی (تحلیل خودکار سختی) ──
# هرچند تا کلید بذاری، همون‌ها فعال میشن و به ترتیب فالبک میرن:
# Gemini اول، بعد OpenAI، بعد Groq، بعد هر API سازگار با OpenAI.
# GEMINI_API_KEY=your-gemini-key
# GEMINI_MODEL=gemini-2.5-flash
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# GROQ_API_KEY=...
# GROQ_MODEL=llama-3.1-8b-instant
# ── اگر کلید Gemini/OpenAI/Groq نداری ولی کلید OpenRouter/DeepSeek داری:
# AI_API_KEY=...
# AI_API_BASE=https://openrouter.ai/api/v1
# AI_MODEL=deepseek/deepseek-chat
# AI_PROVIDER_NAME=OpenRouter
# ── بدون هیچ کلیدی: هیوریستیک لوکال داخل اپ جواب میده.